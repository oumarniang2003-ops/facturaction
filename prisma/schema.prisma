generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id             String          @id @default(cuid())
  businessName   String
  businessSubtitle String?
  slug           String          @unique
  email          String          @unique
  phone          String?
  address        String?
  vatNumber      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  clients        Client[]
  invoices       Invoice[]
  invoiceCounter InvoiceCounter?
  products       Product[]
  subscription   Subscription?
  users          User[]
}

model Subscription {
  id               String    @id @default(cuid())
  merchantId       String    @unique
  plan             Plan      @default(STARTER)
  status           SubStatus @default(TRIALING)
  stripeCustomerId String?
  stripeSubId      String?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  merchant         Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(cuid())
  merchantId   String
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OWNER)
  createdAt    DateTime @default(now())
  merchant     Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Client {
  id         String     @id @default(cuid())
  merchantId String
  type       ClientType @default(INDIVIDUAL)
  name       String
  email      String?
  phone      String?
  address    String?
  vatNumber  String?
  notes      String?
  createdAt  DateTime   @default(now())
  merchant   Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  invoices   Invoice[]

  @@index([merchantId])
}

model Product {
  id            String          @id @default(cuid())
  merchantId    String
  name          String
  sku           String?
  unitPrice     Decimal         @db.Decimal(10, 2)
  vatRate       Decimal         @default(20.00) @db.Decimal(4, 2)
  trackStock    Boolean         @default(false)
  stockQty      Int             @default(0)
  lowStockAlert Int             @default(5)
  createdAt     DateTime        @default(now())
  costPrice     Decimal         @default(0.00) @db.Decimal(10, 2)
  invoiceItems  InvoiceItem[]
  merchant      Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  stockMoves    StockMovement[]

  @@index([merchantId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  quantity  Int
  reason    String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InvoiceCounter {
  id         String   @id @default(cuid())
  merchantId String   @unique
  year       Int
  lastNumber Int      @default(0)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Invoice {
  id              String        @id @default(cuid())
  merchantId      String
  clientId        String
  number          String
  type            DocType       @default(INVOICE)
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  subtotal        Decimal       @db.Decimal(10, 2)
  vatTotal        Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime      @default(now())
  advanceReceived Decimal       @default(0.00) @db.Decimal(10, 2)
  paymentMethod   String?
  client          Client        @relation(fields: [clientId], references: [id])
  merchant        Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items           InvoiceItem[]
  payments        Payment[]

  @@unique([merchantId, number])
  @@index([merchantId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  vatRate     Decimal  @db.Decimal(4, 2)
  lineTotal   Decimal  @db.Decimal(10, 2)
  costPrice   Decimal  @default(0.00) @db.Decimal(10, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod @default(CARD)
  paidAt          DateTime      @default(now())
  stripePaymentId String?
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

enum Plan {
  STARTER
  PRO
  BUSINESS
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum Role {
  OWNER
  EMPLOYEE
  ACCOUNTANT
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum DocType {
  QUOTE
  INVOICE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELED
}

enum PaymentMethod {
  CARD
  CASH
  TRANSFER
  CHECK
  WAVE
  ORANGE_MONEY
}

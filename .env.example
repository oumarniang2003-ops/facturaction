# Base de données (Postgres recommandé - Supabase, Neon, Railway, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/saas_facturation"

# NextAuth
NEXTAUTH_SECRET="générez une chaîne aléatoire avec: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (créez un compte sur stripe.com, récupérez les clés dans le Dashboard > Développeurs)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_BUSINESS="price_..."
# Récupérée quand vous créez le endpoint webhook dans le Dashboard Stripe,
# ou affichée par `stripe listen` en développement local
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (créez un compte gratuit sur resend.com)
RESEND_API_KEY="re_..."
EMAIL_FROM="facturation@votredomaine.com"

# Secret pour protéger la route de relances automatiques (générez une chaîne aléatoire)
CRON_SECRET="générez une chaîne aléatoire avec: openssl rand -base64 32"
